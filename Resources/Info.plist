<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>MultiMessenger</string>
	<key>CFBundleExecutable</key>
	<string>MultiMessenger</string>
	<!-- Kein CFBundleIconName setzen: ohne Assets.car im Bundle läuft die
	     Icon-Suche der Mitteilungszentrale damit ins Leere (leeres Icon in
	     Benachrichtigungen). Nur CFBundleIconFile -> Fallback auf AppIcon.icns. -->
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<!-- Bundle-ID-Wechsel mit v0.3.0 (vormals eu.montybanse.MultiMessenger):
	     Die alte ID war in den Benachrichtigungs-Caches von macOS dauerhaft als
	     „App ohne Icon" eingebrannt. Datenmigration: AppDelegate.migrateLegacyWebKitData(). -->
	<key>CFBundleIdentifier</key>
	<string>eu.montybanse.MultiMessengerApp</string>
	<key>CFBundleName</key>
	<string>MultiMessenger</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.3.3</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>eu.montybanse.MultiMessengerApp.url</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>mmsg</string>
			</array>
		</dict>
		<!-- http/https-Registrierung: dadurch erscheint die App im
		     „Öffnen mit“-Menü von Links (wie ein Browser). Links landen im
		     passenden Dienst (Host-Abgleich) bzw. im Auswahldialog. -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>eu.montybanse.MultiMessengerApp.web</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>http</string>
				<string>https</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>10</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.social-networking</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSCameraUsageDescription</key>
	<string>Damit Videoanrufe in Diensten wie BigBlueButton, Meet oder Slack funktionieren.</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>MultiMessenger</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Damit Sprach- und Videoanrufe in deinen Messengern funktionieren.</string>
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>An MultiMessenger senden</string>
			</dict>
			<key>NSMessage</key>
			<string>handleShareService</string>
			<key>NSPortName</key>
			<string>MultiMessenger</string>
			<key>NSRequiredContext</key>
			<dict/>
			<key>NSSendTypes</key>
			<array>
				<string>public.url</string>
				<string>public.plain-text</string>
				<string>NSStringPboardType</string>
				<string>NSURLPboardType</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
